{
  "kind": "collectionType",
  "collectionName": "exercises",
  "info": {
    "singularName": "exercise",
    "pluralName": "exercises",
    "displayName": "Exercise",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "muscle": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "name": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "weight": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "rest": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "rank": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "workout": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::workout.workout",
      "inversedBy": "exercises"
    },
    "stats": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::stat.stat",
      "mappedBy": "exercise"
    },
    "reps": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "sets": {
      "type": "integer",
      "required": true,
      "min": 1
    }
  }
}
